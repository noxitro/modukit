    <string name="sky_eyebrow_awake">Awake</string>
    <string name="sky_caption_awake">You can update them in the Play Store until the screen turns off.</string>
    <string name="sky_eyebrow_still_awake">Still awake</string>
    <string name="sky_caption_still_awake">They stayed awake after the screen turned off.</string>
