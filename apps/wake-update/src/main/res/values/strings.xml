    <!-- Onboarding -->
    <string name="onboarding_title">Update sleeping apps in one go</string>
    <string name="onboarding_body">Apps in deep sleep don\'t update from the Play Store until they are opened. This app wakes them for a while so they can update, and your deep sleep settings stay as they are.</string>
    <string name="onboarding_step1_title">Wake the apps</string>
    <string name="onboarding_step1_body">Each app appears on screen for a moment. You don\'t need to do anything.</string>
    <string name="onboarding_step2_title">Tap “Update all” in the Play Store</string>
    <string name="onboarding_step2_body">While they are awake, they update like any other app.</string>
    <string name="onboarding_step3_title">Turn off the screen</string>
    <string name="onboarding_step3_body">The apps go back to deep sleep. If some don\'t, this app tells you.</string>
    <string name="onboarding_start">Get started</string>

