    </plurals>
    <string name="notice_not_woken_body">If a confirmation appeared, choose “Allow”. Trying again often works.</string>
    <plurals name="notice_not_back_title">
        <item quantity="one">%d app didn\'t go back to sleep</item>
        <item quantity="other">%d apps didn\'t go back to sleep</item>
    </plurals>
    <string name="notice_not_back_body">Opening them may have taken them off the deep sleep list. Open the list and add them again if you want them to sleep.</string>
    <string name="notice_none_woke_title">Couldn\'t wake any apps</string>
    <string name="notice_none_woke_body">If a confirmation appeared, choose “Allow” and try again. A One UI update may also have changed how apps wake up.</string>

