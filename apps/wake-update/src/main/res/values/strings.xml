    <string name="sky_caption_not_galaxy">Deep sleep is a Galaxy feature, so there is nothing to wake on this phone.</string>
    <string name="sky_title_none">No apps are in deep sleep</string>
    <string name="sky_caption_none">Every app can get updates from the Play Store.</string>
